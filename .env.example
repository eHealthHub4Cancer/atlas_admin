# =============================================================================
# ATLAS CONFIG - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------
# Generate a new secret key for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# DB_MODE: 'local' uses Postgres container in Docker, 'external' connects to external instance
DB_MODE=local

# Database connection settings
DB_HOST=db
DB_PORT=5432
DB_NAME=atlas_config
DB_USER=postgres
DB_PASSWORD=your-secure-password-here

# SSL Configuration (for external databases like RDS, Azure, Supabase)
DB_SSL=false
DB_SSLMODE=prefer
# Path to SSL root certificate (if using verify-ca or verify-full)
DB_SSLROOTCERT_PATH=

# Connection pooling
DB_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# Redis Configuration (for Celery)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery Configuration
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
# Email backend: 'smtp' for production, 'console' for development
EMAIL_BACKEND=smtp

# SMTP Settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Email sender settings
EMAIL_FROM_ADDRESS=noreply@ehealth4cancer.ie
EMAIL_FROM_NAME=Atlas Config
EMAIL_REPLY_TO=ehealth@ul.ie

# For development with MailHog
# EMAIL_HOST=mailhog
# EMAIL_PORT=1025
# EMAIL_USE_TLS=false

# -----------------------------------------------------------------------------
# Super Admin Seed Configuration
# -----------------------------------------------------------------------------
# These credentials are used by the seed_super_admin command
SUPER_ADMIN_EMAIL=admin@ehealth4cancer.ie
SUPER_ADMIN_PASSWORD=ChangeThisSecurePassword123!
SUPER_ADMIN_FIRST_NAME=Admin
SUPER_ADMIN_LAST_NAME=User

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
# CSRF trusted origins (comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Session settings
SESSION_COOKIE_AGE=86400
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Site URL for email links
SITE_URL=http://localhost:8000

# Password reset token expiry (in hours)
PASSWORD_RESET_TIMEOUT_HOURS=24
